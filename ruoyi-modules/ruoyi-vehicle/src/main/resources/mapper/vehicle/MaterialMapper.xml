<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.vehicle.mapper.MaterialMapper">

    <resultMap type="Material" id="MaterialResult">
        <id     property="id"               column="id"                />
        <result property="name"             column="name"              />
        <result property="materialNo"       column="material_no"       />
        <result property="tvv"              column="tvv"               />
        <result property="country"          column="country"           />
        <result property="tire"             column="tire"              />
        <result property="weight"           column="weight"            />
        <result property="brand"            column="brand"             />
        <result property="saleName"         column="sale_name"         />
        <result property="createTime"       column="create_time"       />
        <result property="createBy"         column="create_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="version"          column="version"           />
        <result property="isLast"           column="is_last"           />
        <result property="remark"           column="remark"            />
        <result property="lastVersion"      column="last_version"      />
        <result property="vehicleTemplateId" column="vehicle_template_id"/>
        <result property="effectiveDate"       column="effective_date"       />
        <result property="tireResistanceGrade" column="tire_resistance_grade" />
        <result property="factoryCode"         column="factory_code"          />
        <result property="vehicleModel"         column="vehicle_model"         />
        <result property="status"               column="status"                />
        <result property="cocTemplateNo"    column="coc_template_no"/>
        <result property="wvtaCocNo"        column="wvta_coc_no"/>
        <result property="generateAffirm"   column="generate_affirm"/>
        <result property="uploadAffirm"     column="upload_affirm"/>
        <result property="vehicleTemplateUuid" column="vehicle_template_uuid"/>
    </resultMap>

    <sql id="selectMaterialVo">
        SELECT m.id, m.name, m.material_no, m.tvv, m.country, m.tire, m.weight, m.brand, m.sale_name,
               m.create_time, m.create_by, m.update_time, m.update_by, m.remark, m.vehicle_template_id,
               m.tire_resistance_grade, m.factory_code, m.vehicle_model, m.status, m.generate_affirm,
               m.upload_affirm, m.vehicle_template_uuid, vt.version, vt.is_last
        FROM material m
        LEFT JOIN vehicle_template vt ON vt.uuid = m.vehicle_template_uuid
    </sql>

    <select id="selectMaterialList" parameterType="Material" resultMap="MaterialResult">
        SELECT m.id, m.name, m.material_no, m.tvv, m.country, m.tire, m.weight, m.brand, m.sale_name,
            m.create_time, m.create_by, m.update_time, m.update_by, m.vehicle_template_id,
            m.tire_resistance_grade, m.factory_code, m.vehicle_model, m.status,
            m.generate_affirm, m.upload_affirm, m.vehicle_template_uuid,
            ANY_VALUE(vt.version) AS version, ANY_VALUE(CASE WHEN vt.version = lv.last_version THEN 1 ELSE 0 END) AS is_last,
            ANY_VALUE(vt.effective_date) AS effective_date, ANY_VALUE(lv.last_version) AS last_version,
            ANY_VALUE(vt.remark) AS remark, ANY_VALUE(vt.coc_template_no) AS coc_template_no, ANY_VALUE(vt.wvta_coc_no) AS wvta_coc_no
        FROM material m
        LEFT JOIN vehicle_template vt ON vt.uuid = m.vehicle_template_uuid
        LEFT JOIN (
            SELECT REPLACE(tvv, ',', '') AS tvv, version AS last_version
            FROM (
                SELECT tvv, version, ROW_NUMBER() OVER (PARTITION BY REPLACE(tvv, ',', '') ORDER BY effective_date DESC) AS rn
                FROM vehicle_template
                WHERE is_last = 1
            ) ranked
            WHERE rn = 1
        ) lv ON lv.tvv = m.tvv
        <where>
            AND (vt.is_last = 1 or vt.is_last is null)
            <if test="affirm != null">
                <choose>
                    <when test="affirm == 1">
                        AND m.generate_affirm = 1
                        AND m.upload_affirm = 1
                    </when>
                    <when test="affirm == 0">
                        AND (m.generate_affirm = 0 OR m.upload_affirm = 0)
                    </when>
                </choose>
            </if>
            <if test="name != null and name != ''">
                AND m.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="materialNo != null and materialNo != ''">
                AND m.material_no LIKE CONCAT('%', #{materialNo}, '%')
            </if>
            <if test="tvv != null and tvv != ''">
                AND m.tvv LIKE CONCAT('%', #{tvv}, '%')
            </if>
            <if test="countries != null and countries.size() > 0">
                AND m.country in
                <foreach item="country" collection="countries" open="(" separator="," close=")">
                    #{country}
                </foreach>
            </if>
            <if test="vehicleModels != null and vehicleModels.size() > 0">
                AND m.vehicle_model in
                <foreach item="vehicleModel" collection="vehicleModels" open="(" separator="," close=")">
                    #{vehicleModel}
                </foreach>
            </if>
            <if test="factoryCodes != null and factoryCodes.size() > 0">
                and m.factory_code in
                <foreach item="factoryCode" collection="factoryCodes" open="(" separator="," close=")">
                    #{factoryCode}
                </foreach>
            </if>
            <if test="cocTemplateNo != null and cocTemplateNo != ''">
                AND vt.coc_template_no LIKE CONCAT('%', #{cocTemplateNo}, '%')
            </if>
            <if test="wvtaCocNo != null and wvtaCocNo != ''">
                AND vt.wvta_coc_no LIKE CONCAT('%', #{wvtaCocNo}, '%')
            </if>
            <if test="version != null and version != ''" >
                and vt.version LIKE CONCAT('%', #{version}, '%')
            </if>
            <if test="status != null and status != ''" >
                and m.status = #{status}
            </if>
            <if test="generateAffirm != null">
                and m.generate_affirm = #{generateAffirm}
            </if>
            <if test="uploadAffirm != null">
                and m.upload_affirm = #{uploadAffirm}
            </if>
            <if test="isLast != null and isLast != ''">
                AND vt.is_last = #{isLast}
            </if>
            <if test="status != null">
                AND m.status = #{status}
            </if>
            <if test="vehicleTemplateIds != null and vehicleTemplateIds.size() > 0">
                AND vehicle_template_id in
                <foreach item="templateId" collection="vehicleTemplateIds" open="(" separator="," close=")">
                    #{templateId}
                </foreach>
            </if>
        </where>
        GROUP BY m.id
        ORDER BY m.id DESC
    </select>

    <select id="selectMaterialById" parameterType="Long" resultMap="MaterialResult">
        <include refid="selectMaterialVo"/>
        WHERE m.id = #{id}
        ORDER BY vt.is_last DESC, vt.create_time DESC
        LIMIT 1
    </select>

    <insert id="insertMaterial" parameterType="Material" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO material
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="materialNo != null and materialNo != ''">material_no,</if>
            <if test="tvv != null and tvv != ''">tvv,</if>
            <if test="country != null and country != ''">country,</if>
            <if test="tire != null and tire != ''">tire,</if>
            <if test="weight != null and weight != ''">weight,</if>
            <if test="brand != null and brand != ''">brand,</if>
            <if test="saleName != null and saleName != ''">sale_name,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="vehicleTemplateId != null">vehicle_template_id,</if>
            <if test="tireResistanceGrade != null and tireResistanceGrade != ''">tire_resistance_grade,</if>
            <if test="factoryCode != null and factoryCode != ''">factory_code,</if>
            <if test="vehicleModel != null and vehicleModel != ''">vehicle_model,</if>
            <if test="status != null">status,</if>
            <if test="generateAffirm != null">generate_affirm,</if>
            <if test="uploadAffirm != null">upload_affirm,</if>
            <if test="vehicleTemplateUuid != null and vehicleTemplateUuid != ''">vehicle_template_uuid,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="materialNo != null and materialNo != ''">#{materialNo},</if>
            <if test="tvv != null and tvv != ''">#{tvv},</if>
            <if test="country != null and country != ''">#{country},</if>
            <if test="tire != null and tire != ''">#{tire},</if>
            <if test="weight != null and weight != ''">#{weight},</if>
            <if test="brand != null and brand != ''">#{brand},</if>
            <if test="saleName != null and saleName != ''">#{saleName},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="vehicleTemplateId != null">#{vehicleTemplateId},</if>
            <if test="tireResistanceGrade != null and tireResistanceGrade != ''">#{tireResistanceGrade},</if>
            <if test="factoryCode != null and factoryCode != ''">#{factoryCode},</if>
            <if test="vehicleModel != null and vehicleModel != ''">#{vehicleModel},</if>
            <if test="status != null">#{status},</if>
            <if test="generateAffirm != null">#{generateAffirm},</if>
            <if test="uploadAffirm != null">#{uploadAffirm},</if>
            <if test="vehicleTemplateUuid != null and vehicleTemplateUuid != ''">#{vehicleTemplateUuid},</if>
        </trim>
    </insert>

    <update id="updateMaterial" parameterType="Material">
        UPDATE material
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="materialNo != null and materialNo != ''">material_no = #{materialNo},</if>
            <if test="tvv != null and tvv != ''">tvv = #{tvv},</if>
            <if test="country != null and country != ''">country = #{country},</if>
            <if test="tire != null and tire != ''">tire = #{tire},</if>
            <if test="weight != null and weight != ''">weight = #{weight},</if>
            <if test="brand != null and brand != ''">brand = #{brand},</if>
            <if test="saleName != null and saleName != ''">sale_name = #{saleName},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="vehicleTemplateId != null">vehicle_template_id = #{vehicleTemplateId},</if>
            <if test="tireResistanceGrade != null and tireResistanceGrade != ''">tire_resistance_grade = #{tireResistanceGrade},</if>
            <if test="factoryCode != null and factoryCode != ''">factory_code = #{factoryCode},</if>
            <if test="vehicleModel != null and vehicleModel != ''">vehicle_model = #{vehicleModel},</if>
            <if test="status != null">status = #{status},</if>
            <if test="generateAffirm != null">generate_affirm = #{generateAffirm},</if>
            <if test="uploadAffirm != null">upload_affirm = #{uploadAffirm},</if>
            <if test="vehicleTemplateUuid != null and vehicleTemplateUuid != ''">vehicle_template_uuid = #{vehicleTemplateUuid},</if>
        </trim>
        WHERE id = #{id}
    </update>

    <delete id="deleteMaterialByIds" parameterType="Long">
        DELETE FROM material WHERE id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectByMaterialNo" resultMap="MaterialResult">
        SELECT *
        FROM material
        WHERE material_no = #{materialNo}
            LIMIT 1
    </select>

    <update id="updateMaterialStatus">
        UPDATE material
        SET status      = #{status},
            update_by   = #{updateBy},
            update_time = SYSDATE()
        WHERE id = #{id}
    </update>

    <!-- 模版改动后：重置关联该 uuid 下任意模版的所有物料两个确认状态为 0 -->
    <update id="resetAffirmByTemplateUuid">
        UPDATE material m
            INNER JOIN vehicle_template vt ON vt.uuid = m.vehicle_template_uuid
            SET m.generate_affirm = 0,
                m.upload_affirm   = 0,
                m.update_time     = SYSDATE()
        WHERE vt.uuid = #{uuid}
          AND vt.del_flag = '0' and is_last = 1
    </update>

    <!-- 首台车确认后：按 material_no 更新 generate_affirm -->
    <update id="updateGenerateAffirmByMaterialNo">
        UPDATE material
        SET generate_affirm = #{generateAffirm},
            update_time     = SYSDATE()
        WHERE material_no = #{materialNo}
    </update>

    <!-- 首台车确认后：按 material_no 更新 upload_affirm -->
    <update id="updateUploadAffirmByMaterialNo">
        UPDATE material
        SET upload_affirm = #{uploadAffirm},
            update_time   = SYSDATE()
        WHERE material_no = #{materialNo}
    </update>
    <update id="updateVehicleTemplateIdByUuid">
        UPDATE material
        SET vehicle_template_id = #{templateId},
            update_time = NOW()
        WHERE vehicle_template_id IN (
            SELECT template_id FROM vehicle_template
            WHERE uuid = #{uuid}
              AND del_flag = '0'
        )
    </update>

    <delete id="deleteByMaterialNo">
        DELETE FROM material WHERE material_no = #{materialNo}
    </delete>

    <!-- 查询 tvv 匹配且尚未关联模版的物料号（回溯补关联用） -->
    <select id="selectUnlinkedMaterialsByTvv" resultMap="MaterialResult">
        SELECT *
        FROM material
        WHERE tvv = #{tvv}
          AND (vehicle_template_id IS NULL)
    </select>
</mapper>
